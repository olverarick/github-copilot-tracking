# ─────────────────────────────────────────────────────────────────────────────
# GitHub Copilot Analytics — Variables de entorno
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el .env con valores reales a GitHub
# ─────────────────────────────────────────────────────────────────────────────

# ─── Puertos ─────────────────────────────────────────────────────────────────
API_PORT=5001
FRONTEND_PORT=8081

# URL del backend (usa la IP o dominio donde se despliega)
API_URL=http://localhost:5001

# ─── Frontend ─────────────────────────────────────────────────────────────────
# URL del backend visible desde el navegador
VITE_API_URL=http://localhost:5001

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_PATH=./data/copilot.db

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Genera una clave segura: openssl rand -base64 48
JWT_SECRET_KEY=REEMPLAZAR_CON_CLAVE_SEGURA_MINIMO_32_CHARS

# Contraseña inicial del administrador (cámbiala al primer login)
ADMIN_INITIAL_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO

# ─── Azure OpenAI (opcional — para funciones de IA) ──────────────────────────
AZURE_OPENAI_ENDPOINT=https://TU_RECURSO.openai.azure.com/
AZURE_OPENAI_API_KEY=REEMPLAZAR_CON_TU_API_KEY
AZURE_OPENAI_DEPLOYMENT=gpt-4o
